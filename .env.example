DJANGO_SECRET_KEY=generate-a-real-secret-key-here
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=blog.evillab.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://blog.evillab.tech
WAGTAIL_SITE_NAME="Elder Blog"
WAGTAILADMIN_BASE_URL=https://blog.evillab.tech
DATABASE_DIR=/app/data
MEDIA_DIR=/app/data/media

# Superuser (used by `createsuperuser --noinput`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-after-first-login
